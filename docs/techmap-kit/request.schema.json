{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Techmap request.json",
  "type": "object",
  "required": [
    "requests"
  ],
  "properties": {
    "source": {
      "type": "string",
      "description": "원문 출처 (메일 제목 · Site 게시글 번호 등)"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "req_id",
          "type",
          "layer"
        ],
        "properties": {
          "req_id": {
            "type": "string",
            "description": "고유 ID (예: REQ-2026-001)"
          },
          "type": {
            "type": "string",
            "description": "ADD / CHANGE_DISPLAY / RETIRE / HIDE / SHOW / OPTION_ADD / OPTION_REMOVE"
          },
          "layer": {
            "type": "string",
            "description": "Layer 이름"
          },
          "purpose": {
            "type": "string",
            "description": "Purpose 이름 (RETIRE에서 비우면 Layer 전체)"
          },
          "layer_no": {
            "type": "string",
            "description": "ADD · 신규 Layer일 때 techLayers 번호"
          },
          "abbrev": {
            "type": "string",
            "description": "ADD · 신규 Layer 약어 (비우면 Layer 이름)"
          },
          "purpose_no": {
            "type": "string",
            "description": "ADD · 신규 Purpose일 때 techPurposes 번호"
          },
          "gds_layer": {
            "type": "string",
            "description": "ADD · layermap stream 번호"
          },
          "gds_datatype": {
            "type": "string",
            "description": "ADD · layermap datatype"
          },
          "packet": {
            "type": "string",
            "description": "기존 packet 재사용 / CHANGE에서 공유 packet 직접 수정 시 현재 이름"
          },
          "fill_color": {
            "type": "string",
            "description": "색 이름 · #RRGGBB · R,G,B"
          },
          "outline_color": {
            "type": "string",
            "description": "비우면 Fill_Color와 같게"
          },
          "stipple": {
            "type": "string",
            "description": "drDefineStipple 이름"
          },
          "linestyle": {
            "type": "string",
            "description": "drDefineLineStyle 이름"
          },
          "fill_style": {
            "type": "string",
            "description": "outline / solid / X / stipple / outlineStipple …"
          },
          "option": {
            "type": "string",
            "description": "OPTION_ADD/REMOVE · 대상 Option 이름 (예: 1P9M_6X1Z)"
          },
          "requester": {
            "type": "string",
            "description": "요청자"
          },
          "reason": {
            "type": "string",
            "description": "요청 사유 / Site Request 원문 요약"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "원문만으로 정할 수 없어 사람이 확인할 것"
    }
  }
}
